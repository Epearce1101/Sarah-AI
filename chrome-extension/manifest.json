{
  "manifest_version": 3,
  "name": "Sarah Browser Bridge",
  "version": "1.1.0",
  "description": "Lets Sarah (your desktop companion) browse in this Chrome: open tabs, read pages, click and type. Talks only to Sarah on this PC.",
  "key": "",
  "permissions": ["tabs", "scripting", "alarms", "storage", "debugger"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Sarah Browser Bridge", "default_popup": "popup.html" },
  "icons": { "128": "icon.png" }
}
