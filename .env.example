# SARAH V10 — environment configuration
# Copy to `.env` at repo root and fill in real values. NEVER commit the real .env.

# --- Secrets ---------------------------------------------------------
SARAH_OPENROUTER_API_KEY=
SARAH_GOOGLE_API_KEY=

# --- LLM (OpenRouter, OpenAI-compatible) -----------------------------
SARAH_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Default chat model; a model picked in the UI (click the header label) overrides it.
SARAH_OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
SARAH_OPENROUTER_CONTEXT_WINDOW_TOKENS=1000000
# Tried in order if the chat model fails (OpenRouter allows 2 fallbacks).
SARAH_OPENROUTER_FALLBACK_MODELS=dots-studio/dots-3-note-preview:free,poolside/laguna-s-2.1:free
# Image-capable model used for screenshots/attachments when Ollama isn't available.
SARAH_OPENROUTER_VISION_MODEL=dots-studio/dots-3-note-preview:free
SARAH_OPENROUTER_REASONING_EFFORT=high
SARAH_LLM_MAX_COMPLETION_TOKENS=4096
SARAH_LLM_TEMPERATURE=0.7

# --- Ollama ----------------------------------------------------------
SARAH_OLLAMA_BASE_URL=http://localhost:11434
SARAH_OLLAMA_VISION_MODEL=qwen3-vl:8b
SARAH_LOCAL_MODEL=jessie:latest
SARAH_LLM_MODE=online

# --- Server ----------------------------------------------------------
SARAH_BACKEND_HOST=127.0.0.1
SARAH_BACKEND_PORT=8907
# Shared secret required on every /api call (header X-Sarah-Token). Leave
# blank: start.py generates a fresh one per run and hands it to Electron.
# Set it only to pin a fixed token for tools of your own.
SARAH_API_TOKEN=

# --- Behaviour ----------------------------------------------------------
# IANA zone for conversations with no stored timezone (falls back to the OS zone).
SARAH_DEFAULT_TIMEZONE=America/Denver
# Generate a self-reflection after every memory-mode chat turn (extra LLM call).
SARAH_REFLECTIONS_IN_MEMORY_MODE=false
# Task-state extraction (an LLM call) runs on questions/choices or every N turns (0 = every turn).
SARAH_TASK_STATE_EVERY_N_TURNS=4
# DEBUG shows per-request details (STT steps, vision polls, routing).
SARAH_LOG_LEVEL=INFO

# --- Backups -------------------------------------------------------------
# Daily verified snapshot of the conversation DB; newest N kept.
SARAH_BACKUP_ENABLED=true
SARAH_BACKUP_DIR=
SARAH_BACKUP_KEEP=7

# --- External tool paths (Windows defaults) --------------------------
SARAH_FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
SARAH_FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
SARAH_NODE_PATH=C:\Program Files\nodejs\node.exe
SARAH_NPM_PATH=C:\Program Files\nodejs\npm.cmd
SARAH_OLLAMA_EXE_PATH=C:\Users\Zero\AppData\Local\Programs\Ollama\ollama.exe

# --- SARAH paths (leave blank to use defaults relative to backend) ---
SARAH_WAKE_MODEL_PATH=
SARAH_DRIVE_PATH=
SARAH_DB_PATH=

# --- Identity (OpenClaw read-only integration) -----------------------
# Path to the OpenClaw workspace directory. SARAH reads USER.md from here.
# Leave blank to use the default (~/.openclaw/workspace).
OPENCLAW_WORKSPACE_PATH=
# Fallback name when USER.md is empty/missing.
SARAH_USER_DISPLAY_NAME_FALLBACK=Creator

# --- Safety ----------------------------------------------------------
SARAH_AUTOPILOT_TIER=0
SARAH_RESPECT_PERMISSIONS=true
SARAH_OVERRIDE_PHRASE=Creator override: baseline mode
